generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================

enum Platform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  GOOGLE_BUSINESS
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  PARTIALLY_PUBLISHED
}

enum VariantStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

// ==================== AUTH ====================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  memberships WorkspaceMember[]
  passwordResetTokens PasswordResetToken[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  role        Role      @default(OWNER)
  joinedAt    DateTime  @default(now())

  @@unique([userId, workspaceId])
}

model WorkspaceInvitation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  email     String
  role      Role   @default(EDITOR)
  token     String @unique

  invitedByName String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  acceptedAt    DateTime?

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

// ==================== CORE MODELS ====================

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Obiectiv lunar de interacțiuni, setat manual de user (opțional).
  // Folosit pentru bara de progres "X% din obiectiv" pe /dashboard/analytics.
  monthlyEngagementGoal Int?

  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  connectedAccounts ConnectedAccount[]
  posts             Post[]
  keywordSnapshots  KeywordSnapshot[]
}

model ConnectedAccount {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  platform    Platform
  accountName String
  externalId  String

  accessToken    String    @db.Text
  refreshToken   String?   @db.Text
  tokenExpiresAt DateTime?

  isActive    Boolean  @default(true)
  connectedAt DateTime @default(now())

  variants PostVariant[]
  insights PlatformInsight[]
  demographics AudienceDemographic[]

  @@unique([workspaceId, platform, externalId])
}

model Post {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])

  title  String?
  status PostStatus @default(DRAFT)

  useSameContent Boolean @default(true)

  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  variants PostVariant[]
}

model PostVariant {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  accountId String
  account   ConnectedAccount @relation(fields: [accountId], references: [id])

  platform  Platform
  content   String   @db.Text
  mediaUrls String[]
  hashtags  String[]

  scheduledAt DateTime?

  status         VariantStatus @default(PENDING)
  externalPostId String?
  publishedAt    DateTime?
  errorLog       String?       @db.Text
  retryCount     Int           @default(0)

  insights PlatformInsight[]
  sentiments PostSentiment[]

  @@index([status, scheduledAt])
}

// ==================== ANALYTICS ====================

model PlatformInsight {
  id        String           @id @default(cuid())
  variantId String
  variant   PostVariant      @relation(fields: [variantId], references: [id])
  accountId String
  account   ConnectedAccount @relation(fields: [accountId], references: [id])

  fetchedAt DateTime @default(now())

  impressions Int @default(0)
  reach       Int @default(0)
  likes       Int @default(0)
  comments    Int @default(0)
  shares      Int @default(0)
  saves       Int @default(0)
  clicks      Int @default(0)

  rawData Json?

  @@index([variantId, fetchedAt])
}

model AudienceDemographic {
  id        String           @id @default(cuid())
  accountId String
  account   ConnectedAccount @relation(fields: [accountId], references: [id])

  // "age" | "gender" | "country" | "city"
  dimension String
  // ex: "25-34", "female", "RO"
  label String
  // procent din audiența totală (0-100)
  percentage Float

  capturedAt DateTime @default(now())

  @@index([accountId, dimension, capturedAt])
}

model KeywordSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  keyword String
  source  String // "google_search_console" | "google_trends"

  impressions Int?
  clicks      Int?
  position    Float?
  trendScore  Int?

  capturedAt DateTime @default(now())

  @@index([workspaceId, keyword, capturedAt])
}

model PostSentiment {
  id        String      @id @default(cuid())
  variantId String
  variant   PostVariant @relation(fields: [variantId], references: [id])

  // Numar de comentarii clasificate in fiecare categorie, la momentul capturii.
  // Nu stocam textul comentariilor (doar agregatul), din motive de confidentialitate.
  positiveCount Int @default(0)
  neutralCount  Int @default(0)
  negativeCount Int @default(0)

  capturedAt DateTime @default(now())

  @@index([variantId, capturedAt])
}
