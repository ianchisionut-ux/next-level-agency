generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================

enum Platform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  GOOGLE_BUSINESS
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  PARTIALLY_PUBLISHED
}

enum VariantStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

// ==================== AUTH ====================

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  username     String?  @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  // Acces global (nu per-workspace) la sectiuni sensibile din Signal, ex: "Oferte Web".
  // Contul de super admin vede tot; restul conturilor de admin/staff nu vad Oferte Web.
  isSuperAdmin Boolean @default(false)

  memberships WorkspaceMember[]
  passwordResetTokens PasswordResetToken[]
  calendarItemsAuthored InternalCalendarItem[] @relation("CalendarAuthor")
  calendarItemsAssigned InternalCalendarItem[] @relation("CalendarAssignee")
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  role        Role      @default(OWNER)
  joinedAt    DateTime  @default(now())

  @@unique([userId, workspaceId])
}

model WorkspaceInvitation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  email     String
  role      Role   @default(EDITOR)
  token     String @unique

  invitedByName String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  acceptedAt    DateTime?

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

// ==================== CORE MODELS ====================

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Obiectiv lunar de interacțiuni, setat manual de user (opțional).
  // Folosit pentru bara de progres "X% din obiectiv" pe /dashboard/analytics.
  monthlyEngagementGoal Int?

  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  connectedAccounts ConnectedAccount[]
  posts             Post[]
  campaigns         Campaign[]
  keywordSnapshots  KeywordSnapshot[]
  internalCalendarItems InternalCalendarItem[]
}

model ConnectedAccount {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  platform    Platform
  accountName String
  externalId  String

  accessToken    String    @db.Text
  refreshToken   String?   @db.Text
  tokenExpiresAt DateTime?

  isActive    Boolean  @default(true)
  connectedAt DateTime @default(now())

  variants PostVariant[]
  insights PlatformInsight[]
  demographics AudienceDemographic[]
  pageInsightSnapshots PageInsightSnapshot[]

  @@unique([workspaceId, platform, externalId])
}

model Post {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  title  String?
  status PostStatus @default(DRAFT)

  useSameContent Boolean @default(true)

  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  variants PostVariant[]
}

model Campaign {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  name        String
  description String?   @db.Text

  // Obiectiv opțional (nr. de interacțiuni țintă) - progresul se calculează
  // automat din interacțiunile reale ale postărilor din campanie.
  goal Int?

  startDate DateTime?
  endDate   DateTime?

  // Token unic pentru link-ul public de partajare (fara autentificare) -
  // gen "share/[token]" - se genereaza doar cand userul apasa "Distribuie".
  shareToken String? @unique

  createdAt DateTime @default(now())

  posts Post[]
}

model PostVariant {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  accountId String
  account   ConnectedAccount @relation(fields: [accountId], references: [id])

  platform  Platform
  content   String   @db.Text
  mediaUrls String[]
  hashtags  String[]
  // Etichete de continut ("piloni") - ex: Educational, Promotional, Behind-the-scenes.
  // Setate manual la compose, folosite pentru breakdown de performanta pe categorie.
  contentTags String[]

  scheduledAt DateTime?

  // Ce tip de continut e postarea pe aceasta platforma: "POST" (Feed normal),
  // "STORY" (dispare dupa 24h) sau "REEL" (video, apare in tab-ul Reels).
  // Inlocuieste vechiul boolean postAsReel - acum sunt 3 optiuni, nu 2.
  publishFormat String @default("POST")

  status         VariantStatus @default(PENDING)
  externalPostId String?
  publishedAt    DateTime?
  errorLog       String?       @db.Text
  retryCount     Int           @default(0)

  insights PlatformInsight[]
  sentiments PostSentiment[]

  @@index([status, scheduledAt])
}

// ==================== ANALYTICS ====================

model PlatformInsight {
  id        String           @id @default(cuid())
  variantId String
  variant   PostVariant      @relation(fields: [variantId], references: [id])
  accountId String
  account   ConnectedAccount @relation(fields: [accountId], references: [id])

  fetchedAt DateTime @default(now())

  impressions Int @default(0)
  reach       Int @default(0)
  likes       Int @default(0)
  comments    Int @default(0)
  shares      Int @default(0)
  saves       Int @default(0)
  clicks      Int @default(0)

  rawData Json?

  @@index([variantId, fetchedAt])
}

model AudienceDemographic {
  id        String           @id @default(cuid())
  accountId String
  account   ConnectedAccount @relation(fields: [accountId], references: [id])

  // "age" | "gender" | "country" | "city"
  dimension String
  // ex: "25-34", "female", "RO"
  label String
  // procent din audiența totală (0-100)
  percentage Float

  capturedAt DateTime @default(now())

  @@index([accountId, dimension, capturedAt])
}

// Instantaneu zilnic de statistici LA NIVEL DE PAGINA/CONT (nu per postare) -
// echivalentul cardurilor "Vizualizari / Urmariri / Vizite / Interactiuni" din
// Meta Business Suite -> Statistici -> Prezentare generala. Fiecare camp e
// opțional pentru ca metricile Meta se schimba des (3 valuri de deprecieri
// intre 2023-2026) - colectam fiecare metrica separat, nu grupat, ca daca una
// pica din API, restul tot se salveaza (vezi getFacebookPageOverviewStats).
model PageInsightSnapshot {
  id        String           @id @default(cuid())
  accountId String
  account   ConnectedAccount @relation(fields: [accountId], references: [id])

  views       Int? // page_views_total / IG: views
  follows     Int? // page_follows / IG: follower_count (aproximare, nu delta)
  visits      Int? // page_views_total (FB) / profile_views (IG)
  interactions Int? // page_post_engagements / IG: accounts_engaged
  videoViews  Int? // page_video_views / IG: video_views (best-effort - Meta schimba des numele)
  unfollows   Int? // page_fan_removes (best-effort, poate sa nu mai existe)

  // Ce metrici au esuat la aceasta colectare (nume + motiv) - util pentru
  // diagnostic cand Meta mai scoate din API alte metrici pe neasteptate.
  failedMetrics String[]

  capturedAt DateTime @default(now())

  @@index([accountId, capturedAt])
}

model KeywordSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  keyword String
  source  String // "google_search_console" | "google_trends"

  impressions Int?
  clicks      Int?
  position    Float?
  trendScore  Int?

  capturedAt DateTime @default(now())

  @@index([workspaceId, keyword, capturedAt])
}

model PostSentiment {
  id        String      @id @default(cuid())
  variantId String
  variant   PostVariant @relation(fields: [variantId], references: [id])

  // Numar de comentarii clasificate in fiecare categorie, la momentul capturii.
  // Nu stocam textul comentariilor (doar agregatul), din motive de confidentialitate.
  positiveCount Int @default(0)
  neutralCount  Int @default(0)
  negativeCount Int @default(0)

  capturedAt DateTime @default(now())

  @@index([variantId, capturedAt])
}

// ==================== OFERTE WEB (chestionar / audit de pe site-ul public) ====================
// Nu e legat de niciun Workspace: cine completeaza formularul de pe
// nextlevel-agency.ro/chestionar-audit nu e autentificat si nu alege un client -
// e un lead pentru agentie, vizibil global oricui e logat in Signal.

model WebsiteBrief {
  id     String @id @default(cuid())
  status String @default("NEW") // "NEW" | "CONTACTED" | "ARCHIVED"

  // 1. Afacerea ta & brand
  companyName    String
  activity       String?  @db.Text
  brandIdentity  String?
  ctaGoals       String[]
  linkedCampaign String?

  // 2. Domeniu & Hosting
  hasDomain       String?
  domainName      String?
  hasHosting      String?
  hostingProvider String?
  needsEmail      String?
  wantsSSL        String?

  // 3. Structura & continut
  pages             String[]
  pagesOther        String?
  hasContent        String?
  languages         String?
  otherLanguage     String?
  wantsTestimonials String?

  // 4. Design & functionalitati
  likedSite1             String?
  likedSite2             String?
  visualStyle            String?
  contactElements        String[]
  wantsSocialIntegration String?
  maintenance            String?

  // 5. Marketing & social media
  socialAccounts        String[]
  socialOther           String?
  wantsSocialManagement String?
  adBudget              String?

  // 6. Termen, buget & contact
  launchDate   String?
  budget       String?
  contactName  String
  contactPhone String?
  contactEmail String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}
// ==================== REGISTRU INTERN (proiecte & plati) ====================
// Global, nu per-Workspace - e evidenta financiara proprie a agentiei
// (Next Level), nu a unui client anume. Editabil de orice user autentificat.
model RegistryEntry {
  id          String  @id @default(cuid())
  orderNumber Int     @default(autoincrement())
  projectName String
  amount      Decimal @db.Decimal(10, 2)
  isPaid      Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderNumber])
}

// ==================== CALENDAR INTERN ====================
model InternalCalendarItem {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation("CalendarAuthor", fields: [authorId], references: [id])
  assigneeId  String?
  assignee    User?     @relation("CalendarAssignee", fields: [assigneeId], references: [id])

  title       String
  notes       String?   @db.Text
  type        String    @default("NOTE")
  priority    String    @default("MEDIUM")
  status      String    @default("TODO")
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, startAt])
  @@index([assigneeId, status])
}