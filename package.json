{
  "name": "next-level-agency",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db execute --file prisma/website-brief-offers.sql --schema prisma/schema.prisma && prisma db execute --file prisma/document-register.sql --schema prisma/schema.prisma && next build",
    "test:accounting-xml": "node scripts/test-accounting-xml.cjs",
    "test:invoicing-core": "node scripts/test-invoicing-core.cjs",
    "audit:invoicing": "node scripts/audit-invoicing.cjs",
    "check:public-site": "node scripts/check-public-site.cjs",
    "audit:seo": "node scripts/audit-public-seo.cjs",
    "test:hero": "node scripts/test-hero-framing.cjs && node scripts/test-hero-runtime.cjs",
    "test:project-preview": "node scripts/test-project-preview.cjs",
    "test:mailbox": "node scripts/test-mailbox-core.cjs && node scripts/test-mailbox-service.cjs && node scripts/test-mailbox-archive.cjs && node scripts/test-mailbox-ui.cjs && node scripts/test-transaction-email.cjs && node scripts/test-mailbox-setup.cjs",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed:admins": "node scripts/seed-admins.js"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@react-pdf/renderer": "^4.1.6",
    "@vercel/blob": "2.4.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "jose": "^5.9.6",
    "lucide-react": "^1.33.0",
    "next": "^16.0.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.12.7",
    "resend": "^4.0.1",
    "sanitize-html": "2.18.2",
    "three": "0.187.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "2.16.2",
    "@types/three": "0.187.0",
    "htmlparser2": "8.0.2",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
